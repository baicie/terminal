{
  "name": "@terminal/monorepo",
  "version": "0.0.1-dev.1",
  "description": "Modern SSH/SFTP terminal client with team collaboration",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": "24.16.x",
    "pnpm": "10.34.x"
  },
  "scripts": {
    "dev": "cross-env tauri dev",
    "dev:all": "pnpm -r --parallel dev",
    "dev:frontend": "pnpm --filter=@terminal/frontend dev",
    "dev:team-server": "pnpm --filter=team-server start:dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter=@terminal/frontend build",
    "build:team-server": "pnpm --filter=team-server build",
    "tauri": "tauri",
    "smoke:terminal": "node scripts/run-terminal-smoke.mjs",
    "smoke:terminal:reconnect": "node scripts/run-terminal-smoke.mjs --reconnect",
    "smoke:cold-start": "node scripts/run-cold-start-stopwatch.mjs",
    "smoke:remote-cold-start": "node scripts/run-remote-cold-start-stopwatch.mjs",
    "shadcn": "pnpm --filter=@terminal/frontend shadcn",
    "format": "pnpm --filter=@terminal/frontend format",
    "lint": "pnpm --filter=@terminal/frontend lint",
    "lint:fix": "pnpm --filter=@terminal/frontend lint:fix",
    "typecheck": "pnpm --filter=@terminal/frontend typecheck",
    "test": "pnpm --filter=@terminal/frontend test",
    "test:watch": "pnpm --filter=@terminal/frontend test:watch",
    "test:coverage": "pnpm --filter=@terminal/frontend test:coverage",
    "check:source-size": "node scripts/check-source-size.mjs",
    "verify": "node scripts/verify.mjs all",
    "verify:frontend": "node scripts/verify.mjs frontend",
    "verify:team-server": "node scripts/verify.mjs team-server",
    "verify:rust": "node scripts/verify.mjs rust",
    "analyze:bundle": "tsx scripts/analyze-bundle-size.ts",
    "smoke:ssh-matrix": "node scripts/run-terminal-smoke-matrix.mjs",
    "smoke:input-probe": "node scripts/run-input-probe.mjs",
    "smoke:raw-input": "node scripts/run-raw-input-probe.mjs",
    "smoke:shell-probe": "node scripts/run-terminal-shell-probe.mjs",
    "smoke:shell-probe:matrix": "node scripts/run-terminal-shell-probe-matrix.mjs",
    "icon:source": "python3 scripts/generate-icon.py",
    "icon": "pnpm icon:source && pnpm tauri icon src-tauri/icons/icon-source.png --output src-tauri/icons"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.0",
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "2.3.0",
      "deepmerge-ts": "8.0.1",
      "fast-uri": "3.1.5",
      "js-yaml": "5.2.3",
      "qs": "6.15.2"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ],
    "patchedDependencies": {
      "@baicie/xterm@0.1.7": "patches/@baicie__xterm@0.1.7.patch"
    }
  }
}
