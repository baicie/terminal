# Docker Compose database. Replace the password before first start.
POSTGRES_USER=terminal
POSTGRES_PASSWORD=change-this-long-random-password
POSTGRES_DB=terminal
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Server
PORT=3000
# Required; use an exact development, test, or production value.
NODE_ENV=production
TEAM_SERVER_BIND_ADDRESS=127.0.0.1
TEAM_SERVER_PORT=3000
# Production defaults to disabled; set true only when API docs are required.
SWAGGER_ENABLED=false
REGISTRATION_MODE=closed
# Required only when REGISTRATION_MODE=token; use at least 32 random characters.
# REGISTRATION_TOKEN=

# CORS (comma-separated exact origins; wildcard is rejected)
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420,http://127.0.0.1:1420
