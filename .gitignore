# Logs
logs
*.log
# The evidence bundle keeps the raw runner output so a reviewer can audit the
# numbers in docs/verification/*.json; do not let the blanket *.log rule hide it.
!docs/verification/raw/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-stats.md
dist-stats.json
*.local
*.tsbuildinfo
vite.config.d.ts
.env
.env.*
!.env.example
team-server/dist

# Python generated caches
__pycache__/
*.py[cod]

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Phase 8.9 Task 5: pre-install data snapshots the install-chain scripts write and
# the CI job uploads as an artifact. They are run output, not sources.
verify-install-evidence/

# Local scratch directory: one-off probe JSON and throwaway scripts kept while
# chasing a specific failure. Never an input to a gate, so a stray `git add -A`
# must not sweep it into a commit.
.workbuddy/

# Historical client tree materialised by
# scripts/verify-install/prepare-team-sync-a.mjs for the cross-version run.
packages/team-server/.tmp/

# Written by scripts/verify-install/team-cross-version.mjs in CI.
team-cross-version-report.json
